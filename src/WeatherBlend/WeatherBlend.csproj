<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WeatherBlend</RootNamespace>
    <AssemblyName>weatherblend</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\phases.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <InternalsVisibleTo Include="WeatherBlend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />

    <!-- HTTP + resilience -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />

    <!-- Config + DI + logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <!-- Direct YamlDotNet reference for PhaseRegistry's typed deserialiser.
         Already transitively present via NetEscapades; pinning here so the
         registry loader doesn't break if the transitive ever drops. -->
    <PackageReference Include="YamlDotNet" Version="13.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Storage / query -->
    <PackageReference Include="Parquet.Net" Version="5.0.2" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.1.1" />

    <!-- ML (for the trainer in phase 2) -->
    <PackageReference Include="Microsoft.ML" Version="4.0.0" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="4.0.0" />

    <!-- Phase 3e MLP — TorchSharp .NET-native PyTorch binding for the
         tabular NN bake-off vs 3a/3c/4a. TorchSharp is the managed
         wrapper; TorchSharp-cpu pulls the CPU-only libtorch native
         binaries (~500 MB native install on first restore for win-x64
         + linux-x64 + osx-arm64). CPU-only because our 30k × 59 MLP
         fits comfortably without GPU and we don't want CUDA dragged
         into GH runner builds.

         Pinned to 0.105.0 — the actively-maintained 0.10x line as of
         late 2024 / early 2025. Bumps need re-verifying that the
         tabular MLP API (torch.nn.Linear / torch.nn.Sequential /
         BCELoss / Adam / state_dict save+load) hasn't drifted; the
         library reshuffles its public surface across minor versions. -->
    <PackageReference Include="TorchSharp" Version="0.105.0" />
    <PackageReference Include="TorchSharp-cpu" Version="0.105.0" />
  </ItemGroup>

</Project>
