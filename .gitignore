# Build output
bin/
obj/
out/

# IDE
.vs/
.idea/
*.user
*.suo

# Data - never commit data directories
data/
logs/
# Exception: orographic static features (9 per-station JSON files, ~2 KB
# each, derived from a stable DEM). Treated as code-adjacent static
# config — needed at both train AND predict time, same shape as
# phases.yaml. The DEM .tif tile that generates them stays gitignored
# (see data/static/dem/) — only the cheap derived JSONs commit. Leading
# slashes anchor the carve-outs to the repo-root data/ dir so build-
# output trees like src/WeatherBlend/data/ stay fully ignored.
!/data/
/data/*
!/data/static/
/data/static/*
!/data/static/orographic/
!/data/static/orographic/*.json

# OS
Thumbs.db
.DS_Store

# User config overrides (if you add them later)
config.local.yaml
appsettings.Local.json

# Phase 3 tooling (local machine state, not repo artefacts)
.venv/
tmp/
__pycache__/
*.pyc

# Wrangler (Cloudflare Pages deploy tooling — local cache/tmp only)
.wrangler/

# Local bake-off / experiment CSVs — regenerable from the scripts and
# captured in memory entries; only commit a CSV when it's a permanent
# reference (precedent: lgbm_meta_bakeoff_*, stack_bakeoff_* are kept).
reports/4way_bakeoff_*.csv
reports/3g_source_bakeoff_*.csv
reports/3a_vs_3e_daytime_diagnostic.csv
